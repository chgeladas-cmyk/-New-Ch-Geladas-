rules_version = '2';

/**
 * CH Geladas PDV — Firestore Security Rules v3
 * ─────────────────────────────────────────────────────────────────────
 *
 * COLEÇÕES E PERMISSÕES
 * ┌─────────────────────┬────────────────────┬──────────────────────────────┐
 * │  Coleção            │  Leitura           │  Escrita                     │
 * ├─────────────────────┼────────────────────┼──────────────────────────────┤
 * │  ch_dados/estoque   │  PDV + ADM         │  ADM (adminToken)            │
 * │  ch_dados/config    │  PDV + ADM         │  ADM (adminToken)            │
 * │  ch_dados/categorias│  PDV + ADM         │  ADM (adminToken)            │
 * │  ch_dados/*outros*  │  ADM               │  ADM (adminToken)            │
 * │  vendas/{id}        │  ADM               │  PDV + ADM                   │
 * │  movimentacoes/{id} │  ADM               │  ADM + sistema (transaction) │
 * │  lotes/{id}         │  ADM               │  PDV + ADM (sem adminToken)  │
 * │  movimentacoesLote/{id} │ ADM            │  PDV + ADM (sem adminToken)  │
 * │  saidas/{id}        │  ADM               │  ADM + GERENTE (sem token)   │
 * │  categorias/{id}    │  PDV + ADM         │  ADM                         │
 * │  fornecedores/{id}  │  ADM               │  ADM                         │
 * │  backups/{data}/**  │  ADM               │  ADM (adminToken)            │
 * └─────────────────────┴────────────────────┴──────────────────────────────┘
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Funções auxiliares ───────────────────────────────────────────

    function autenticado() {
      return request.auth != null;
    }

    function docValido(data) {
      return data.keys().hasAll(['dados', 'ts'])
          && data.ts is string
          && data.ts.size() > 0;
    }

    function temAdminToken(data) {
      return data.keys().hasAny(['adminToken'])
          && data.adminToken is string
          && data.adminToken.size() == 64; // FIX #6: SHA-256 tem exatamente 64 chars
    }

    function vendaValida(data) {
      return data.keys().hasAll(['id', 'total', 'itens', 'criadoEm'])
          && data.total is number
          && data.itens is list;
    }

    function fiadoValido(data) {
      return data.keys().hasAll(['id'])
          && data.id is string
          && data.id.size() > 0;
    }

    function financeiroValido(data) {
      return data.keys().hasAll(['id', 'tipo', 'valor'])
          && data.id is string
          && data.id.size() > 0
          && data.valor is number;
    }

    function movimentacaoValida(data) {
      return data.keys().hasAll(['produtoId', 'tipo', 'quantidade', 'timestamp'])
          && data.quantidade is number;
    }

    function loteValido(data) {
      return data.keys().hasAll(['id', 'produtoId', 'quantidadeInicial', 'custoTotalReal', 'custoUnitario'])
          && data.produtoId is string
          && data.quantidadeInicial is number
          && data.custoTotalReal is number;
    }

    function movimentacaoLoteValida(data) {
      return data.keys().hasAll(['id', 'loteId', 'produtoId', 'tipo', 'quantidade', 'timestamp'])
          && data.quantidade is number
          && data.tipo is string;
    }

    function saidaValida(data) {
      return data.keys().hasAll(['id', 'tipo', 'valor'])
          && data.id is string
          && data.id.size() > 0
          && data.valor is number;
    }

    function pontoValido(data) {
      return data.keys().hasAll(['id', 'tipo', 'nome'])
          && data.id is string
          && data.id.size() > 0
          && data.tipo is string;
    }

    // Coleções abertas para leitura por qualquer autenticado (PDV + ADM)
    function colecaoPublica(colecao) {
      return colecao in ['estoque', 'config', 'categorias'];
    }

    // ─── /ch_dados/comandas — qualquer autenticado pode escrever ────
    // Comandas são criadas por colaboradores/operadores sem adminToken
    match /ch_dados/comandas {
      allow read:  if autenticado();
      allow write: if autenticado() && docValido(request.resource.data);
    }

    // ─── /ch_dados/fiado — qualquer autenticado pode escrever ───────
    match /ch_dados/fiado {
      allow read:  if autenticado();
      allow write: if autenticado() && docValido(request.resource.data);
    }

    // ─── /ch_dados/cambio — qualquer autenticado pode escrever ──────
    match /ch_dados/cambio {
      allow read:  if autenticado();
      allow write: if autenticado() && docValido(request.resource.data);
    }

    // ─── /ch_dados/ponto — qualquer autenticado pode escrever ───────
    // Ponto é registrado por colaboradores sem adminToken.
    // Controle de edição/cancelamento é feito no app (admin only).
    match /ch_dados/ponto {
      allow read:  if autenticado();
      allow write: if autenticado() && docValido(request.resource.data);
    }

    // ─── /ch_dados/caixastatus — qualquer autenticado pode escrever ──
    // FIX (set/2026): status ao vivo do caixa por operador, extraído de
    // dentro de 'ponto' (era reescrito ali a cada abertura/fechamento/
    // sangria/retirada — mover pro padrão de coleção própria usado em
    // saidas/financeiro custaria até 1000 escritas por evento). 1 doc
    // único, cada operador grava só a própria chave via merge de campo
    // (dot-path) no client — a regra aqui só valida a forma do documento
    // resultante, não impõe merge (isso é responsabilidade do client-side
    // FirebaseService.salvar, que sempre usa {merge:true}). Nenhum dos
    // papéis que publicam status (colaborador/gerente/operador/admin)
    // gera adminToken exceto admin/adm — mesmo motivo de ponto/fiado.
    match /ch_dados/caixastatus {
      allow read:  if autenticado();
      allow write: if autenticado() && docValido(request.resource.data);
    }

    // ─── /ch_dados/perfis — qualquer autenticado pode ler, admin escreve ──
    match /ch_dados/perfis {
      allow read:  if autenticado();
      allow write: if autenticado() && docValido(request.resource.data) && temAdminToken(request.resource.data);
    }

    // ─── /ch_dados/pedidos — cardápio público + equipe (entregador/gerente) ──
    // FIX (set/2026): não existia regra própria — caía no catch-all
    // /ch_dados/{colecao} abaixo, que exige adminToken. O pedido nasce no
    // cardápio público (cliente sem login/PIN, só auth anônima do
    // Firebase) e é depois atualizado por entregador/gerente/operador no
    // módulo Delivery — nenhum desses tem adminToken (só admin/adm geram
    // um no login). Resultado: toda escrita de pedidos era recusada com
    // permission-denied, e o pedido só chegava via Telegram (canal
    // separado, fora do Firestore). Mesmo padrão de comandas/fiado/ponto.
    match /ch_dados/pedidos {
      allow read:  if autenticado();
      allow write: if autenticado() && docValido(request.resource.data);
    }

    // ─── /ch_dados/{colecao} ─────────────────────────────────────────
    match /ch_dados/{colecao} {

      // Leitura: qualquer autenticado pode ler qualquer coleção.
      // O controle de acesso por role é feito no app (SyncService.pull filtra por role).
      // request.resource.data não existe em leituras — não pode ser usado aqui.
      allow read: if autenticado();

      // Escrita: exige adminToken e documento válido
      allow write: if autenticado()
                   && docValido(request.resource.data)
                   && temAdminToken(request.resource.data);
    }

    // ─── /vendas/{vendaId} ───────────────────────────────────────────
    // create: PDV e colaboradores (sem adminToken)
    // update: qualquer autenticado (aprovação/validação pelo controlador/validador)
    // delete: apenas admin (adminToken obrigatório)
    match /vendas/{vendaId} {
      allow create: if autenticado() && vendaValida(request.resource.data);
      allow read:   if autenticado();
      allow update: if autenticado();
      allow delete: if autenticado() && temAdminToken(request.resource.data);
    }

    // ─── /fiado/{clienteId} ────────────────────────────────────────────
    // FIX (jul/2026): regra que faltava desde a migração de ch_dados/fiado
    // (doc único) para este modelo por-cliente. Sem esta regra, toda
    // escrita em 'fiado' caía no bloqueio geral do fim do arquivo
    // (match /{document=**} { allow read, write: if false; }) e nunca
    // chegava no Firestore — risco real de perda de dados de fiado.
    // create/update: qualquer autenticado (saldo muda a cada venda/pagamento,
    // registrado por pdv/validador/gerente/admin, sem adminToken — mesmo
    // comportamento que o antigo /ch_dados/fiado).
    // delete: apenas admin.
    match /fiado/{clienteId} {
      allow create, update: if autenticado() && fiadoValido(request.resource.data);
      allow read:   if autenticado();
      allow delete: if autenticado() && temAdminToken(request.resource.data);
    }

    // ─── /financeiro/{lancId} ────────────────────────────────────────
    // FIX (jul/30 2026): regra que faltava desde a migração de
    // ch_dados/financeiro (doc único) para este modelo por-lançamento
    // (core.js grava direto em financeiro/{lanc.id}). Sem esta regra,
    // toda escrita em 'financeiro' caía no bloqueio geral do fim do
    // arquivo (match /{document=**} { allow read, write: if false; }) e
    // era recusada com permission-denied — mesmo bug já corrigido antes
    // para 'fiado'.
    // create: qualquer autenticado (lançamento é gerado por venda/estorno/
    // despesa em vários pontos do app, sem exigir adminToken).
    // update: mantido restrito a admin — 'financeiro' é log append-only,
    // igual 'vendas' e 'movimentacoes'; a única escrita esperada pós-criação
    // é a própria migração (que roda como admin) ou correções manuais.
    // delete: apenas admin.
    match /financeiro/{lancId} {
      allow create: if autenticado() && financeiroValido(request.resource.data);
      allow read:   if autenticado();
      allow update: if autenticado() && temAdminToken(request.resource.data);
      allow delete: if autenticado() && temAdminToken(request.resource.data);
    }

    // ─── /saidas/{saidaId} ───────────────────────────────────────────
    // FIX (set/2026): saidas migrado de ch_dados/saidas (doc único, mesmo
    // risco de teto de 1MB já corrigido antes em financeiro/fiado) para
    // este modelo por-lançamento (core.js grava direto em saidas/{id}).
    // create: qualquer autenticado — sem isso, 'gerente' (que tem permissão
    // de escrever 'saidas' mas NUNCA gera adminToken, só admin/adm geram)
    // ficaria com toda saída recusada com permission-denied, igual ao
    // bug já visto em fiado/financeiro. Mesmo padrão de 'financeiro' acima.
    // update: log append-only — só correção manual/migração (admin).
    // delete: apenas admin (exclusão marca _deleted, ver FirebaseService.deletar).
    match /saidas/{saidaId} {
      allow create: if autenticado() && saidaValida(request.resource.data);
      allow read:   if autenticado();
      allow update: if autenticado() && temAdminToken(request.resource.data);
      allow delete: if autenticado() && temAdminToken(request.resource.data);
    }

    // ─── /ponto/{pontoId} ────────────────────────────────────────────
    // FIX (set/2026, etapa 2): ponto migrado de ch_dados/ponto (doc
    // único, mesmo risco de teto de 1MB) para este modelo por-registro
    // (core.js grava direto em ponto/{id}). O status de caixa de alta
    // frequência já não mora mais aqui (ver /ch_dados/caixastatus acima)
    // — o que resta (entrada/saída de turno, sangria, retirada,
    // fechamento) é criado sem adminToken (colaborador/gerente/operador
    // nunca geram um), mas editado/cancelado/restaurado/apagado só por
    // admin (que sempre tem adminToken) — mesmo padrão de 'saidas' acima.
    match /ponto/{pontoId} {
      allow create: if autenticado() && pontoValido(request.resource.data);
      allow read:   if autenticado();
      allow update: if autenticado() && temAdminToken(request.resource.data);
      allow delete: if autenticado() && temAdminToken(request.resource.data);
    }

    // ─── /fiado_backups/{snapshotId} ───────────────────────────────────
    // Snapshot incremental do fiado a cada alteração (proteção extra além
    // do backup diário em /backups). Mesmo nível de acesso que /fiado —
    // qualquer autenticado grava, ninguém edita/apaga pelo app (só leitura
    // pra restauração manual, feita como admin).
    match /fiado_backups/{snapshotId} {
      allow create: if autenticado();
      allow read:   if autenticado();
      allow update, delete: if autenticado() && temAdminToken(request.resource.data);
    }

    // ─── /movimentacoes/{movId} ──────────────────────────────────────
    match /movimentacoes/{movId} {
      allow create: if autenticado() && movimentacaoValida(request.resource.data);
      allow read:   if autenticado();
      allow update, delete: if autenticado()
                             && temAdminToken(request.resource.data);
    }

    // ─── /lotes/{loteId} ──────────────────────────────────────────────
    // Rastreabilidade de investimento/custo por lote de compra (FIFO).
    // create: qualquer autenticado — o lote nasce numa entrada de estoque
    // (compra), feita por colaborador/operador/gerente/admin, sem exigir
    // adminToken (mesmo padrão de 'vendas'/'financeiro' abaixo).
    // update: qualquer autenticado — diferente de 'vendas'/'financeiro',
    // o PRÓPRIO documento do lote é atualizado a cada venda, estorno ou
    // devolução (quantidadeDisponivel/status mudam), não é só um log
    // append-only. Já é o mesmo nível de acesso que 'vendas' já usa pra
    // status de aprovação (autenticado, sem adminToken).
    // delete: apenas admin.
    match /lotes/{loteId} {
      allow create: if autenticado() && loteValido(request.resource.data);
      allow read:   if autenticado();
      allow update: if autenticado();
      allow delete: if autenticado() && temAdminToken(request.resource.data);
    }

    // ─── /movimentacoesLote/{movId} ────────────────────────────────────
    // Log imutável de cada consumo/estorno/devolução de lote — mesmo
    // espírito de /movimentacoes: uma vez criado pelo app, nunca é
    // editado, só novos registros são adicionados.
    match /movimentacoesLote/{movId} {
      allow create: if autenticado() && movimentacaoLoteValida(request.resource.data);
      allow read:   if autenticado();
      allow update, delete: if autenticado()
                             && temAdminToken(request.resource.data);
    }

    // ─── /categorias/{catId} ─────────────────────────────────────────
    match /categorias/{catId} {
      allow read:  if autenticado();
      allow write: if autenticado() && temAdminToken(request.resource.data);
    }

    // ─── /fornecedores/{fornId} ──────────────────────────────────────
    match /fornecedores/{fornId} {
      allow read:  if autenticado();
      allow write: if autenticado() && temAdminToken(request.resource.data);
    }

    // ─── /backups/{data}/snapshots/{snapshotId} ──────────────────────
    // Backup automático diário — apenas admin escreve e lê
    match /backups/{data}/snapshots/{snapshotId} {
      // Leitura: autenticado é suficiente (dados sensíveis já são sanitizados pelo BackupService)
      allow read:  if autenticado();
      // Escrita: exige adminToken (apenas admin pode gerar backups)
      allow write: if autenticado() && temAdminToken(request.resource.data);
    }

    // ─── /ch_dados/usuarios — lista de usuarios sincronizada ────────
    // Usuarios podem ser lidos por qualquer autenticado.
    // Escrita exige adminToken (apenas admin cria/edita usuarios).
    // Override da regra geral /ch_dados/{colecao} para explicitar.
    // (A regra geral ja cobre, mas deixamos explícito para clareza.)

    // ─── SaaS: empresas, usuários, convites ─────────────────────────
    // Arquitetura: signInAnonymously (sem custom claims / sem Cloud Functions)
    // Autorização feita no app via saasToken (hash SHA-256 da senha master)
    // armazenado em sessionStorage e enviado nos campos dos documentos.
    //
    // saas_token field: presente em escritas administrativas (64 chars hex SHA-256)
    function temSaasToken(data) {
      return data.keys().hasAny(['saas_token'])
          && data.saas_token is string
          && data.saas_token.size() == 64;
    }

    // saas_empresas: leitura aberta para autenticados (dados não sensíveis)
    // Escrita exige saas_token (super admin) ou campo empresaId correto (dono)
    match /saas_empresas/{empId} {
      allow read:  if autenticado();
      allow write: if autenticado();
    }

    // saas_usuarios: leitura e escrita por autenticados
    // Controle fino feito no app (verifica senhaHash, empresaId, ativo)
    match /saas_usuarios/{uid} {
      allow read:  if autenticado();
      allow write: if autenticado();
    }

    // saas_convites: aberto para autenticados
    // Convite só funciona se codigo correto + não usado + não expirado (validado no app)
    match /saas_convites/{codigo} {
      allow read:  if autenticado();
      allow write: if autenticado();
    }

    // saas_dados: isolamento por empresaId no path
    // App valida sessão — Firestore garante que só autenticados chegam aqui
    match /saas_dados/{empId}/{colecao}/{docId} {
      allow read, write: if autenticado();
    }

    // ─── /ch_tripwire/{docId} — Log imutável de intrusões ────────────
    // Qualquer autenticado (incluindo PDV anônimo) pode CRIAR.
    // Ninguém pode atualizar ou deletar — nem o admin via console.
    match /ch_tripwire/{docId} {
      allow create: if autenticado();
      allow read:   if autenticado();
      allow update, delete: if false;
    }

    // ─── Bloqueia tudo que não foi mapeado ───────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
